# Firebase Web app configuration (public identifiers, not service-account credentials)
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id

# Official Firebase AI Logic hybrid cloud fallback model.
VITE_FIREBASE_AI_MODEL=gemini-3.5-flash-lite

# Unpacked/local judging builds only. Firebase creates a per-install token at runtime.
# Never put the emitted debug token in this file or commit it.
VITE_FIREBASE_APPCHECK_DEBUG=false
